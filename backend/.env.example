# Copy to .env and edit. Every value here is optional except SIGNUP_CODE and
# WORKER_SECRET, and BLENDER_PATH on Windows.

PORT=5500

# Without this nobody can create an account, including the first one.
# Pick something and tell your team.
SIGNUP_CODE=change-me

# Authenticates the renderer's callbacks. Generate one with:
#   node -e "console.log(require('crypto').randomBytes(32).toString('hex'))"
# Left unset, a throwaway is generated per start and workers on other machines
# cannot authenticate.
WORKER_SECRET=

# Required on Windows, where Blender is not on PATH. Match the version folder
# actually installed.
# BLENDER_PATH=C:\Program Files\Blender Foundation\Blender 5.2\blender.exe

# CPU, CUDA, OPTIX, HIP, ONEAPI or METAL. Cycles only. Drop it without a GPU.
CYCLES_DEVICE=CPU

# Where uploads, renders, scratch space, logs and the database live.
# Defaults to the backend/ directory.
# DATA_DIR=D:\RenderNetData

# Disk each user may hold across uploads and frames. Default 5 GB.
# USER_QUOTA_BYTES=5368709120

# Backstop sweep for files nobody came back for. Default 14.
# RETENTION_DAYS=14

# Disk kept spare whatever the per-user quotas allow. Below this, uploads are
# refused and queued renders are held rather than failed. Default 5 GB.
# MIN_FREE_BYTES=5368709120

# Database snapshots kept in backups/, one taken on every start. Default 7.
# DB_BACKUPS_KEPT=7

# How long dated logs are kept, and the size at which the day's log rotates.
# LOG_RETENTION_DAYS=30
# MAX_LOG_BYTES=8388608

# Base URL the renderer posts frames and progress back to. Only needs setting
# if the server does not listen on localhost:5500.
# API_URL=http://localhost:5500
