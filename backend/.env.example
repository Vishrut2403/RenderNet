# Copy to .env and edit. Every value here is optional except SIGNUP_CODE, and
# BLENDER_PATH on Windows.

PORT=5500

# Without this nobody can create an account, including the first one.
# Pick something and tell your team.
SIGNUP_CODE=change-me

# The farm-wide secret this used to need. Leave it unset: the workstation mints
# a credential for its own renderers at every start, and a machine elsewhere is
# issued one of its own under Admin. A value set here keeps working and appears
# in that list, where it can be revoked once nothing uses it.
# WORKER_SECRET=

# Required on Windows, where Blender is not on PATH. Match the version folder
# actually installed.
# BLENDER_PATH=C:\Program Files\Blender Foundation\Blender 5.2\blender.exe

# CPU, CUDA, OPTIX, HIP, ONEAPI or METAL. Cycles only. Drop it without a GPU.
CYCLES_DEVICE=CPU

# Optional: makes a video of the finished frames available beside them. Without
# ffmpeg the farm renders as usual and simply cannot offer one.
# FFMPEG_PATH=C:\ffmpeg\bin\ffmpeg.exe
# VIDEO_FPS=24

# Engines this machine accepts frames for. Defaults to whatever its Blender
# lists; narrow it on a headless box where EEVEE has no GL context.
# WORKER_ENGINES=CYCLES

# Serve HTTPS instead of HTTP. Both or neither: with only one set the server
# stops rather than quietly falling back to plain HTTP. Generate a pair with
#   openssl req -x509 -newkey rsa:2048 -nodes -days 825 \
#     -keyout tls-key.pem -out tls-cert.pem \
#     -subj "/CN=rendernet" -addext "subjectAltName=DNS:rendernet"
# TLS_KEY=/path/to/tls-key.pem
# TLS_CERT=/path/to/tls-cert.pem

# Only needed if the UI is served from somewhere other than this server. Left
# unset, a page on another site gets no permission to read the API at all.
# ALLOWED_ORIGINS=http://studio.local:8080

# Where uploads, renders, scratch space, logs and the database live.
# Defaults to the backend/ directory.
# DATA_DIR=D:\RenderNetData

# Largest scene a chunked upload may carry, and how long an upload nobody came
# back to finish is kept. Default 2 GB and 6 hours.
# MAX_UPLOAD_BYTES=2147483648
# PARTIAL_TTL_MS=21600000

# Disk each user may hold across uploads and frames. Default 10 GB.
# USER_QUOTA_BYTES=10737418240

# Backstop sweep for files nobody came back for. Default 14.
# RETENTION_DAYS=14

# Disk kept spare whatever the per-user quotas allow. Below this, uploads are
# refused and queued renders are held rather than failed. Default 5 GB.
# MIN_FREE_BYTES=5368709120

# Database snapshots kept in backups/, one taken on every start. Default 7.
# DB_BACKUPS_KEPT=7

# How long dated logs are kept, and the size at which the day's log rotates.
# LOG_RETENTION_DAYS=30
# MAX_LOG_BYTES=8388608

# Base URL the renderer posts frames and progress back to. Only needs setting
# if the server does not listen on localhost:5500.
# API_URL=http://localhost:5500

# How many renderers this machine runs. Each is its own process, started and
# restarted by the server. 0 leaves the machine coordinating only, for a farm
# whose rendering happens elsewhere.
# WORKER_SLOTS=1

# On a second machine, run "npm run worker" in backend/ with API_URL pointed at
# the server, the WORKER_TOKEN it was issued under Admin, and these two set. The
# worker downloads each scene over HTTP and renders in its own scratch space.
# WORKER_TOKEN=
# WORKER_REMOTE=1
# WORKER_SCRATCH_DIR=D:\RenderNetScratch

# How long a worker's claim on a frame lasts before another may take it. The
# worker renews every few seconds while a frame is rendering.
# LEASE_TTL_MS=120000
