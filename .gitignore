# .gitignore

# Dependencies
node_modules/
frontend/dist/
npm-debug.log*
yarn-debug.log*
yarn-error.log*

# Environment variables
.env
.env.local

# Uploaded files and renders
uploads/
renders/
output/
worker-tmp/
backend/uploads/
backend/renders/
backend/output/
backend/worker-tmp/

# OS files
.DS_Store
Thumbs.db

# IDE files
.vscode/
.idea/
*.swp
*.swo

# Logs
*.log
logs/

# Database snapshots taken at each start
backups/

# Database
*.db
*.db-wal
*.db-shm
*.sqlite
users.json
users.json.migrated

# Temporary files
tmp/
temp/
*.tmp

# Blender cache
*.blend1
*.blend2